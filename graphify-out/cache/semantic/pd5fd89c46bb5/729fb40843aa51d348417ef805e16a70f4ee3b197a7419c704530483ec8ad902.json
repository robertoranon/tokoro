    {
      "id": "crawler_specs_date_inference",
      "label": "Date inference logic (year hints, day-name validation)",
      "file_type": "rationale",
      "source_file": "crawler/SPECS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "LLMs often can't reliably infer the year from partial dates; cross-validating the extracted day_name against the actual weekday of the candidate date (current year, +1, -1) catches off-by-one-year errors. Events with no valid year match, or whose only valid match is in the past, are dropped rather than published wrong."
    },
