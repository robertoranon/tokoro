    {
      "id": "crawler_specs_geocoding",
      "label": "Geocoding via Nominatim with fallback cascade",
      "file_type": "rationale",
      "source_file": "crawler/SPECS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "A cascading fallback (full address -> drop possible venue prefix -> venue+address -> venue alone -> LLM-assisted Google-search address lookup) maximizes geocode success given inconsistent address quality across scraped pages, while a module-level timestamp enforces Nominatim's 1 req/sec rate limit."
    },
    {
      "id": "crawler_specs_timestamp_normalization",
      "label": "Timestamp normalization (strip TZ, no UTC conversion)",
      "file_type": "rationale",
      "source_file": "crawler/SPECS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Must NOT route through Date.toISOString() or UTC-converting datetime formatting, since that would shift the wall-clock time; the timezone suffix is stripped (not converted) so venue-local time is preserved. A post-geocoding timezone-aware fallback fills in placeholder times using the venue's IANA timezone when JSON-LD supplied a real UTC datetime."
    },
    {
      "id": "crawler_specs_event_signing",
      "label": "Ed25519 event signing (canonical JSON + SHA-256)",
