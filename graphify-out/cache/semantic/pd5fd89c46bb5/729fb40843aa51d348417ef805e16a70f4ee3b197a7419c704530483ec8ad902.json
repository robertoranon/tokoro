    },
    {
      "id": "crawler_specs_duplicate_check",
      "label": "Pre-publish duplicate check (Levenshtein + LLM probability)",
      "file_type": "rationale",
      "source_file": "crawler/SPECS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Checking nearby existing events (\u00b11h, 0.1km) via title-similarity plus an LLM duplicate-probability call before publishing avoids relying solely on the API's 409 response; if the LLM check errors, it fails open (treated as not-duplicate) so the worker's own dedup logic remains the final authority."
    }
