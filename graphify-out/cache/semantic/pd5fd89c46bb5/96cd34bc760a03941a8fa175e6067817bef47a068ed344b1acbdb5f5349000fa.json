      "id": "chrome_extension_specs_main_world_content_script",
      "label": "MAIN world content script for element-based image extraction",
      "file_type": "rationale",
      "source_file": "chrome-extension/SPECS.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "MAIN world execution is required so chrome.scripting.executeScript can read variables set by the content script (e.g. right-click position, used to find images hidden behind DOM overlays like Instagram). Trade-off: the content script can be affected by page scripts, but ISOLATED world cannot share variables with executeScript."
    }
