    {
      "id": "docs_diving_deeper_tracing_an_event",
      "label": "Tracing an Event from Browser to Database",
      "file_type": "document",
      "source_file": "docs/diving-deeper/tracing-an-event.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
