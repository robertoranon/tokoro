      "contributor": null
    },
    {
      "id": "docs_diving_deeper_tracing_an_event_stateless_signing_design",
      "label": "Stateless crawler worker / client-side signing design",
      "file_type": "rationale",
      "source_file": "docs/diving-deeper/tracing-an-event.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Crawler worker returns unsigned PreparedEvents and never sees a private key; the curator's keypair lives in browser storage and all signing happens via the Web Crypto API before the event leaves the user's machine. Keeps the extraction pipeline stateless and free of identity concerns; a 401 signature failure always points to browser-side code, not the worker."
    },
    {
      "id": "docs_diving_deeper_tracing_an_event_serverside_html_cleaning",
      "label": "Server-side HTML cleaning (extractCleanText)",
      "file_type": "rationale",
      "source_file": "docs/diving-deeper/tracing-an-event.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "The browser captures rendered HTML (JS executed, lazy elements resolved, iframes assembled) and sends it raw; the worker cleans it server-side so cleaning logic can evolve without shipping a new extension version, and so the worker can run both JSON-LD and LLM extraction passes over the same response body."
    },
    {
      "id": "docs_diving_deeper_tracing_an_event_iframe_capture_race",
      "label": "Iframe capture raced against 5s timeout",
      "file_type": "rationale",
      "source_file": "docs/diving-deeper/tracing-an-event.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Main-frame capture (allFrames:false) always finishes quickly; the iframe pass (allFrames:true) is raced against a 5-second timeout so a stuck third-party widget (Bandcamp player, Bandsintown calendar, social embed) cannot block extraction indefinitely."
    },
    {
      "id": "docs_diving_deeper_tracing_an_event_canonical_json_key_order",
      "label": "Canonical JSON fixed key order for signature integrity",
      "file_type": "rationale",
      "source_file": "docs/diving-deeper/tracing-an-event.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "JSON.stringify serializes keys in insertion order, so both the signing client and the API worker must build the canonical object with the identical field sequence (pubkey, title, description, url, venue_name, address, lat, lng, start_time, end_time, category, tags, created_at) and identical empty-field normalization, or verification fails with 401. Most common source of signature errors when extending the event schema."
    },
    {
      "id": "docs_diving_deeper_tracing_an_event_event_id_content_hash",
      "label": "Event ID = SHA-256 of canonical JSON",
      "file_type": "rationale",
      "source_file": "docs/diving-deeper/tracing-an-event.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Content-derived ID means identical event data always produces the same ID regardless of submitter, so exact re-submissions hit the D1 primary key constraint before the more expensive similarity check runs; also lets a client predict an event's ID before publishing, useful for idempotent crawler re-runs."
    },
    {
      "id": "docs_diving_deeper_tracing_an_event_dual_geohash_precision",
      "label": "Two geohash precisions for radius queries",
      "file_type": "rationale",
      "source_file": "docs/diving-deeper/tracing-an-event.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "D1/SQLite has no spatial index type, so the worker stores geohash5 (~5km) and geohash6 (~1.2km) per event; a radius query hashes the center at the matching precision, assembles the nine-cell neighborhood, fetches candidates, then applies a Haversine filter. geohash6 is used for small radii (<=5km), geohash5 for larger ones."
    },
    {
      "id": "docs_diving_deeper_tracing_an_event_ninecell_duplicate_check",
      "label": "Nine-cell geohash neighborhood duplicate check",
      "file_type": "rationale",
      "source_file": "docs/diving-deeper/tracing-an-event.md",
      "source_location": null,
      "source_url": null,
      "captured_at": null,
      "author": null,
      "contributor": null,
      "rationale": "Two events at the same venue can land in adjacent geohash cells if coordinates sit near a cell edge; querying only the center cell would miss those comparisons, so the duplicate check queries the center cell plus its 8 neighbors."
    },
