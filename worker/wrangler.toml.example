name = "tokoro-worker"
main = "src/index.ts"
compatibility_date = "2024-01-01"
compatibility_flags = ["nodejs_compat"]
workers_dev = true

[[d1_databases]]
binding = "DB"
database_name = "tokoro-db"
database_id = "YOUR_D1_DATABASE_ID"

[triggers]
# 02:00 UTC: expire old events + R2 backup. 08:00 UTC: Telegram alert digests.
crons = ["0 2 * * *", "0 8 * * *"]

[[r2_buckets]]
binding = "BACKUP_BUCKET"
bucket_name = "tokoro-backups"

[vars]
# Secrets (set via: wrangler secret put <name>)
# - ADMIN_PUBKEY: admin public key for blocklist management
# - ALLOWED_PUBKEYS: Comma-separated Ed25519 public keys (hex) allowed to publish events.
#   If not set, any valid signature is accepted.
#   Always include the crawler CLI's CRAWLER_PUBKEY value for automated publishing.
#   Example: wrangler secret put ALLOWED_PUBKEYS
# - LLM_API_KEY: API key for LLM provider (used for duplicate detection)
# - LLM_PROVIDER: LLM provider name (default: openrouter)
# - LLM_MODEL: Optional model override
# - TELEGRAM_BOT_TOKEN: same token as the crawler-worker bot; enables the 08:00 digests
# - TELEGRAM_BOT_USERNAME: bot username without @ (for t.me link codes)
# - TELEGRAM_BOT_PUBKEY: the bot's BOT_PUBKEY; the only key accepted on /telegram/*
# - PUBLIC_WEB_URL: public-web base URL, for the links at the end of a digest
# - ADMIN_TELEGRAM_CHAT_ID: (optional) Telegram chat id of the admin. That chat
#   gets one message per new conflict and every digest alert (all bands, all
#   festival editions). Unset = nothing is sent. Find it: message the bot, open
#   https://api.telegram.org/bot<TOKEN>/getUpdates and read message.chat.id
# - ADMIN_PAGE_URL: (optional) URL of the admin page, linked from conflict notices
